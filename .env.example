# CardMax Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# Google Places API key
# Get one at: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# Enable: "Places API" (not Places API New)
# Restrict to: iOS apps with bundle ID com.cardmax.app
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
